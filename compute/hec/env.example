# HEC S3 credentials for `./run.py hec` and `./run.py batch`.
# Copy this file to compute/hec/env and fill in real values.
# `./run.py` auto-loads it — no manual `source` needed. Shell env still wins.
# compute/hec/env itself is gitignored.

# Cloud Compute orchestrator (where payloads live + outputs land)
CC_AWS_ACCESS_KEY_ID=
CC_AWS_SECRET_ACCESS_KEY=
CC_AWS_DEFAULT_REGION=us-east-1
CC_AWS_ENDPOINT=https://s3.hecdev.net
CC_AWS_S3_BUCKET=storm-cloud
CC_ROOT=manifests

# FFRD bucket (where watershed/transposition geometries live)
FFRD_AWS_ACCESS_KEY_ID=
FFRD_AWS_SECRET_ACCESS_KEY=
FFRD_AWS_DEFAULT_REGION=us-east-1
FFRD_AWS_ENDPOINT=https://s3.hecdev.net
FFRD_AWS_S3_BUCKET=storm-cloud

# Optional: private AORC cache to skip NOAA public bucket
# AORC_S3_BASE_URL=s3://storm-cloud/aorc-cache
# AORC_S3_KEY=
# AORC_S3_SECRET=
# AORC_S3_ENDPOINT=https://s3.hecdev.net
